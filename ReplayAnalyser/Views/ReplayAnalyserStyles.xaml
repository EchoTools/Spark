<!--
    Shared look for the Replay Analyser pages. Every colour is a DynamicResource from Spark's theme,
    so a theme change repaints the pages live.

    Two things about Spark's theme shape these templates:
      - Its implicit TextBlock style pins Foreground to ControlDefaultForeground. It reaches the text
        a ContentPresenter makes for string content too, so a button's own Foreground never shows.
        Templates here draw their text with a TextBlock that takes the control's Foreground instead.
      - Its implicit ListBox style turns content scrolling off, which quietly disables
        virtualisation; the library list sets it back.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:Spark.ReplayAnalyser.Views"
                    xmlns:rc="clr-namespace:Spark.ReplayAnalyser.Controls">

    <v:BoolToVisibility x:Key="RaBoolVis"/>
    <v:BoolToVisibility x:Key="RaNotBoolVis" Invert="True"/>
    <v:NotEmptyToVisibility x:Key="RaNotEmptyVis"/>
    <v:InverseBool x:Key="RaNot"/>
    <v:ZeroToVisibility x:Key="RaZeroVis"/>

    <FontFamily x:Key="RaNumFont">Consolas, Cascadia Mono</FontFamily>

    <!-- ============ text ============ -->
    <Style x:Key="RaPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="RaHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="RaBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="17"/>
    </Style>

    <Style x:Key="RaCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="RaNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RaNumFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <!-- A label on the left, its figure on the right: the rows of every small stat table. -->
    <Style x:Key="RaStatLabel" TargetType="TextBlock" BasedOn="{StaticResource RaBody}">
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="0,3,12,3"/>
    </Style>

    <Style x:Key="RaStatValue" TargetType="TextBlock" BasedOn="{StaticResource RaNumber}">
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,3,0,3"/>
    </Style>

    <!-- ============ surfaces ============ -->
    <Style x:Key="RaCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,12,14,14"/>
    </Style>

    <!-- Inset panel inside a card, for summaries and figures. -->
    <Style x:Key="RaWell" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceGround}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,9"/>
    </Style>

    <!-- A small team-coloured tick beside a name. -->
    <Style x:Key="RaSideTick" TargetType="Border">
        <Setter Property="Width" Value="3"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <!-- ============ buttons ============ -->
    <Style x:Key="RaButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ControlMouseOverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RaAccentButton" TargetType="Button" BasedOn="{StaticResource RaButton}">
        <Setter Property="Background" Value="{DynamicResource ControlAccent}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlAccentForeground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.86"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.72"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ navigation ============ -->
    <!-- Page switcher along the top of the tab: quiet at rest, raised when selected — the same
         treatment as Spark's own tab strip. -->
    <Style x:Key="RaNavPill" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="11,6">
                        <TextBlock x:Name="label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ControlMouseOverBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceRaised}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter TargetName="label" Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Two-way switch (This match / All time): the chosen half fills with the accent. -->
    <Style x:Key="RaSegment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="12,5">
                        <TextBlock x:Name="label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlAccent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ControlAccentForeground}"/>
                            <Setter TargetName="label" Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ inputs ============ -->
    <Style x:Key="RaTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceGround}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource ControlAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                      Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SurfaceTrack}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ControlAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Player picker: the theme's ComboBox, sized to sit in a card header. -->
    <Style x:Key="RaPicker" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinWidth" Value="180"/>
        <Setter Property="MaxWidth" Value="260"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!-- A bar showing a share, 0..1: the theme's progress bar without its chrome. -->
    <Style x:Key="RaMeter" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlAccent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3"
                                HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ templates ============ -->

    <!-- Player pickers show the name with their team colour beside it. -->
    <DataTemplate x:Key="RaPlayerName">
        <StackPanel Orientation="Horizontal">
            <Border Width="3" Height="13" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center"
                    rc:ToneBrush.Background="{Binding Tone}"/>
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
        </StackPanel>
    </DataTemplate>

    <!-- A coaching point: coloured spine, kind and area, headline, the number behind it, the fix. -->
    <DataTemplate x:Key="RaInsightCard">
        <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="7,0,0,7" rc:ToneBrush.Background="{Binding Tone}"/>
                <StackPanel Grid.Column="1" Margin="12,10,12,11">
                    <WrapPanel>
                        <Border CornerRadius="4" Padding="6,1" Margin="0,0,8,2" rc:ToneBrush.Tint="{Binding Tone}">
                            <TextBlock Text="{Binding Kind}" FontSize="9.5" FontWeight="Bold"
                                       rc:ToneBrush.Foreground="{Binding Tone}"/>
                        </Border>
                        <TextBlock Text="{Binding Area}" Style="{StaticResource RaCaption}" Margin="0,1,10,2"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Evidence}" Style="{StaticResource RaCaption}" Margin="0,1,0,2"
                                   Foreground="{DynamicResource TextDim}" FontWeight="Normal" VerticalAlignment="Center"
                                   Visibility="{Binding HasEvidence, Converter={StaticResource RaBoolVis}}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource RaHeading}" FontSize="13.5" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource RaBody}" Margin="0,3,0,0"/>
                    <Border Style="{StaticResource RaWell}" Margin="0,8,0,0" Padding="10,7"
                            Visibility="{Binding HasAction, Converter={StaticResource RaBoolVis}}">
                        <TextBlock Text="{Binding Action}" Style="{StaticResource RaBody}" Foreground="{DynamicResource TextPrimary}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- The same card without the area label, for the matchup and career lists. -->
    <DataTemplate x:Key="RaMatchupCard">
        <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="7,0,0,7" rc:ToneBrush.Background="{Binding Tone}"/>
                <StackPanel Grid.Column="1" Margin="12,10,12,11">
                    <WrapPanel>
                        <Border CornerRadius="4" Padding="6,1" Margin="0,0,8,2" rc:ToneBrush.Tint="{Binding Tone}">
                            <TextBlock Text="{Binding Kind}" FontSize="9.5" FontWeight="Bold"
                                       rc:ToneBrush.Foreground="{Binding Tone}"/>
                        </Border>
                        <TextBlock Text="{Binding Evidence}" Style="{StaticResource RaCaption}" Margin="0,1,0,2"
                                   Foreground="{DynamicResource TextDim}" FontWeight="Normal" VerticalAlignment="Center"
                                   Visibility="{Binding HasEvidence, Converter={StaticResource RaBoolVis}}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource RaHeading}" FontSize="13.5" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource RaBody}" Margin="0,3,0,0"/>
                    <Border Style="{StaticResource RaWell}" Margin="0,8,0,0" Padding="10,7"
                            Visibility="{Binding HasAction, Converter={StaticResource RaBoolVis}}">
                        <TextBlock Text="{Binding Action}" Style="{StaticResource RaBody}" Foreground="{DynamicResource TextPrimary}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- A measured habit, as a chip. -->
    <DataTemplate x:Key="RaTagChip">
        <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="10" Padding="10,3" Margin="0,0,6,6"
                BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1">
            <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{DynamicResource TextPrimary}"/>
        </Border>
    </DataTemplate>

    <!-- Card lists run two across when there is room and one when there isn't. The gap lives in
         the panel rather than on the cards, so side-by-side cards also share a row height. -->
    <ItemsPanelTemplate x:Key="RaCardColumns">
        <rc:Columns MinColumnWidth="360" MaxColumns="2" Gap="8"/>
    </ItemsPanelTemplate>

    <!-- The same spacing for lists that should stay one card wide, like a half-width column. -->
    <ItemsPanelTemplate x:Key="RaCardStack">
        <rc:Columns MaxColumns="1" Gap="8"/>
    </ItemsPanelTemplate>

</ResourceDictionary>
