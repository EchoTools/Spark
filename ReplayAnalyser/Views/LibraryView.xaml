<UserControl x:Class="Spark.ReplayAnalyser.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rc="clr-namespace:Spark.ReplayAnalyser.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Spark;component/ReplayAnalyser/Views/ReplayAnalyserStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="RowText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Replay library" Style="{StaticResource RaPageTitle}"/>
            <TextBlock Style="{StaticResource RaBody}" Margin="0,3,0,0"
                       Text="Every .butter, .echoreplay and .tape recording in the folder. Index once and the scores, rosters and career trends stay available without re-reading the files."/>
        </StackPanel>

        <!-- folder + actions -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Style="{StaticResource RaTextBox}"
                     Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="The folder to read replays from. Type a path and press Rescan, or use Browse."/>
            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource RaButton}"
                    Command="{Binding BrowseCommand}" Margin="6,0,0,0"/>
            <Button Grid.Column="2" Content="Rescan" Style="{StaticResource RaButton}"
                    Command="{Binding RefreshCommand}" Margin="6,0,0,0"/>
            <Button Grid.Column="3" Content="Index folder" Style="{StaticResource RaAccentButton}"
                    Command="{Binding IndexCommand}" Margin="6,0,0,0"
                    ToolTip="Read every replay not yet indexed, so the list shows scores and rosters and the all-time pages have data."
                    Visibility="{Binding IsIndexing, Converter={StaticResource RaNotBoolVis}}"/>
            <Button Grid.Column="3" Content="Stop indexing" Style="{StaticResource RaButton}"
                    Command="{Binding CancelIndexCommand}" Margin="6,0,0,0"
                    Visibility="{Binding IsIndexing, Converter={StaticResource RaBoolVis}}"/>
        </Grid>

        <!-- status + search -->
        <rc:Columns Grid.Row="2" Margin="0,10,0,10" MinColumnWidth="220" Weights="3,2" Gap="12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding LibraryStatus}" FontSize="11.5" Foreground="{DynamicResource TextDim}"/>
                <ProgressBar Style="{StaticResource RaMeter}" Height="4" Maximum="100" Margin="0,6,0,0"
                             Value="{Binding IndexProgress, Mode=OneWay}"
                             Visibility="{Binding IsIndexing, Converter={StaticResource RaBoolVis}}"/>
            </StackPanel>
            <Grid>
                <TextBox Style="{StaticResource RaTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Search by player, map or filename" IsHitTestVisible="False"
                           Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </rc:Columns>

        <!-- the list -->
        <Border Grid.Row="3" Style="{StaticResource RaCard}" Padding="4">
            <Grid>
                <!-- Spark's ListBox style turns content scrolling off, which would build a row for
                     every file in the folder; switched back on here so only visible rows exist. -->
                <ListBox ItemsSource="{Binding FilesView}"
                         SelectedItem="{Binding SelectedEntry}"
                         IsSynchronizedWithCurrentItem="False"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid>
                                            <Border x:Name="row" Background="Transparent" CornerRadius="6" Padding="12,7">
                                                <ContentPresenter/>
                                            </Border>
                                            <Border x:Name="bar" Width="3" CornerRadius="2" HorizontalAlignment="Left"
                                                    Margin="0,9" Background="{DynamicResource ControlAccent}" Visibility="Collapsed"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="{DynamicResource SurfaceRaised}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="{DynamicResource SurfaceTrack}"/>
                                                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- when -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Recorded, StringFormat='{}{0:ddd d MMM}'}"
                                               FontSize="12.5" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Recorded, StringFormat='{}{0:HH:mm}'}" Style="{StaticResource RowText}"
                                               Foreground="{DynamicResource TextFaint}"/>
                                </StackPanel>

                                <!-- what -->
                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SubTitle}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12.5"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusBad}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsIndexed}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding RosterLine}" Style="{StaticResource RowText}"
                                               Visibility="{Binding RosterLine, Converter={StaticResource RaNotEmptyVis}}"/>
                                    <TextBlock Text="{Binding FileName}" Style="{StaticResource RowText}"
                                               Foreground="{DynamicResource TextFaint}"
                                               Visibility="{Binding IsIndexed, Converter={StaticResource RaNotBoolVis}}"/>
                                </StackPanel>

                                <!-- score -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                                            Visibility="{Binding HasScore, Converter={StaticResource RaBoolVis}}">
                                    <TextBlock Text="{Binding BlueScoreText}" FontFamily="{StaticResource RaNumFont}" FontSize="15"
                                               FontWeight="Bold" Foreground="{DynamicResource TeamBlue}"/>
                                    <TextBlock Text="–" FontSize="13" Margin="6,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFaint}"/>
                                    <TextBlock Text="{Binding OrangeScoreText}" FontFamily="{StaticResource RaNumFont}" FontSize="15"
                                               FontWeight="Bold" Foreground="{DynamicResource TeamOrange}"/>
                                </StackPanel>

                                <!-- length, or file size until indexed -->
                                <TextBlock Grid.Column="3" Text="{Binding DurationText}" Width="50" TextAlignment="Right"
                                           VerticalAlignment="Center" FontFamily="{StaticResource RaNumFont}" FontSize="11.5"
                                           Foreground="{DynamicResource TextDim}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- nothing to list: say why -->
                <TextBlock Text="{Binding LibraryStatus}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" MaxWidth="360" Margin="16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource RaBody}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Files.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
