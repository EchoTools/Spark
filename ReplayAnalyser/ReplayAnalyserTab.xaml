<UserControl x:Class="Spark.ReplayAnalyserTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:Spark.ReplayAnalyser.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="820"
             Background="{DynamicResource SurfaceGround}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Spark;component/ReplayAnalyser/Views/ReplayAnalyserStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ header: pages, and the match that's open ═══════════ -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceChrome}"
                BorderBrush="{DynamicResource SurfaceBorderSoft}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Margin="10,7,12,8">
                    <WrapPanel x:Name="Nav">
                        <RadioButton Content="Library" Tag="0" GroupName="RaPages" Style="{StaticResource RaNavPill}"
                                     IsChecked="True" Checked="OnPageChecked"/>
                        <RadioButton Content="Overview" Tag="1" GroupName="RaPages" Style="{StaticResource RaNavPill}"
                                     Checked="OnPageChecked"/>
                        <RadioButton Content="Players" Tag="2" GroupName="RaPages" Style="{StaticResource RaNavPill}"
                                     Checked="OnPageChecked"/>
                        <RadioButton Content="Teams" Tag="3" GroupName="RaPages" Style="{StaticResource RaNavPill}"
                                     Checked="OnPageChecked"/>
                        <RadioButton Content="Coaching" Tag="4" GroupName="RaPages" Style="{StaticResource RaNavPill}"
                                     Checked="OnPageChecked"/>
                        <RadioButton Content="All-time" Tag="5" GroupName="RaPages" Style="{StaticResource RaNavPill}"
                                     Checked="OnPageChecked"/>
                        <RadioButton Content="Trends" Tag="6" GroupName="RaPages" Style="{StaticResource RaNavPill}"
                                     Checked="OnPageChecked"/>
                    </WrapPanel>

                    <!-- the open match: scoreline, file and its shape -->
                    <DockPanel Margin="2,7,0,0" Visibility="{Binding HasMatch, Converter={StaticResource RaBoolVis}}">
                        <Border DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0" Padding="9,2"
                                CornerRadius="6" Background="{DynamicResource SurfaceCard}"
                                BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="BLUE" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,7,0"
                                           Foreground="{DynamicResource TeamBlue}"/>
                                <TextBlock Text="{Binding BlueScoreText}" FontFamily="{StaticResource RaNumFont}" FontSize="16"
                                           FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TeamBlue}"/>
                                <TextBlock Text="–" FontSize="13" Margin="7,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFaint}"/>
                                <TextBlock Text="{Binding OrangeScoreText}" FontFamily="{StaticResource RaNumFont}" FontSize="16"
                                           FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TeamOrange}"/>
                                <TextBlock Text="ORANGE" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" Margin="7,0,0,0"
                                           Foreground="{DynamicResource TeamOrange}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding MatchTitle}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" ToolTip="{Binding MatchTitle}"/>
                            <TextBlock Text="{Binding MatchSubtitle}" FontSize="11" Margin="0,1,0,0"
                                       Foreground="{DynamicResource TextFaint}" ToolTip="{Binding MatchSubtitle}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- reading progress, what the reader had to repair, or why a replay wouldn't open -->
                    <TextBlock Text="{Binding LoadStatus}" FontSize="11" Margin="2,5,0,0"
                               Foreground="{DynamicResource TextDim}" ToolTip="{Binding LoadStatus}"
                               Visibility="{Binding LoadStatus, Converter={StaticResource RaNotEmptyVis}}"/>
                </StackPanel>

                <ProgressBar VerticalAlignment="Bottom" Height="2" BorderThickness="0"
                             Background="Transparent" Foreground="{DynamicResource ControlAccent}"
                             IsIndeterminate="{Binding IsLoading}"
                             Visibility="{Binding IsLoading, Converter={StaticResource RaBoolVis}}"/>
            </Grid>
        </Border>

        <!-- ═══════════ pages ═══════════ -->
        <!-- Every page is built once and shown or hidden, so switching keeps each one's scroll
             position, selections and rendered heatmaps instead of rebuilding them. -->
        <Grid Grid.Row="1" x:Name="Pages">
            <views:LibraryView Tag="0"/>
            <views:OverviewView Tag="1" Visibility="Collapsed"/>
            <views:PlayersView Tag="2" Visibility="Collapsed"/>
            <views:TeamsView Tag="3" Visibility="Collapsed"/>
            <views:CoachingView Tag="4" Visibility="Collapsed"/>
            <views:AllTimeView Tag="5" Visibility="Collapsed"/>
            <views:TrendsView Tag="6" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
