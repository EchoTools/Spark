<Window x:Class="Spark.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Spark"
        mc:Ignorable="d"
        Title="New Update Available" 
        Width="520" 
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundColour}"
        BorderBrush="{DynamicResource ControlDefaultBorderBrush}"
        BorderThickness="1"
        Icon="/img/ignite_logo.ico"
        FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <Label Content="Spark Update Available!" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="{DynamicResource ControlPrimaryBrightDefaultBackground}" 
                   Padding="0" 
                   Margin="0,0,0,4"/>
            <TextBlock Text="A newer version of Spark is ready for you. Review the changes below:" 
                       TextWrapping="Wrap" 
                       Foreground="{DynamicResource ControlDefaultForeground}" 
                       FontSize="13" 
                       Opacity="0.85"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="Current Version: " Foreground="{DynamicResource ControlDefaultForeground}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CurrentVersionText" Text="v1.0.0" Foreground="{DynamicResource ControlDefaultForeground}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="New Version: " Foreground="{DynamicResource ControlPrimaryBrightDefaultBackground}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LatestVersionText" Text="v1.0.1" Foreground="{DynamicResource ControlPrimaryBrightDefaultBackground}" FontWeight="Bold"/>
                </StackPanel>
            </Grid>

            <Border x:Name="ChangelogBorder" 
                    Grid.Row="1"
                    BorderBrush="{DynamicResource ControlDefaultBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    Background="{DynamicResource ControlDarkerBackground}" 
                    Padding="12" 
                    Margin="0,0,0,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ChangelogText" 
                               Text="Changelog details go here..." 
                               TextWrapping="Wrap" 
                               Foreground="{DynamicResource ControlDefaultForeground}" 
                               FontSize="12.5" 
                               FontFamily="Consolas" 
                               LineHeight="18"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <StackPanel x:Name="ProgressArea" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" 
                           Text="Downloading update..." 
                           Foreground="{DynamicResource ControlDefaultForeground}" 
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" 
                           HorizontalAlignment="Center"/>
                <ProgressBar x:Name="DownloadProgressBar" 
                             Height="16" 
                             Minimum="0" 
                             Maximum="100" 
                             Value="0">
                    <ProgressBar.Style>
                        <Style TargetType="{x:Type ProgressBar}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="true">
                                            <Border CornerRadius="4" 
                                                    Background="{DynamicResource ControlDarkerBackground}" 
                                                    BorderBrush="{DynamicResource ControlDefaultBorderBrush}" 
                                                    BorderThickness="1"/>
                                            <Border CornerRadius="3" 
                                                    x:Name="PART_Indicator" 
                                                    HorizontalAlignment="Left" 
                                                    Background="{DynamicResource ControlPrimaryDefaultBackground}" 
                                                    Margin="1"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StackPanel>

            <CheckBox x:Name="IgnoreUpdateCheckBox" 
                      Content="Skip this update version" 
                      Foreground="{DynamicResource ControlDefaultForeground}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,0"
                      Visibility="{Binding ElementName=ActionButtons, Path=Visibility}"/>

            <StackPanel x:Name="ActionButtons" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center">
                <Button x:Name="LaterButton" 
                        Content="Later" 
                        Width="100" 
                        Height="34" 
                        Margin="0,0,12,0" 
                        Click="LaterButton_Click" 
                        FontWeight="SemiBold"/>
                <Button x:Name="UpdateButton" 
                        Content="Update Now" 
                        Width="130" 
                        Height="34" 
                        Click="UpdateButton_Click" 
                        Background="{DynamicResource ControlPrimaryDefaultBackground}"
                        BorderBrush="{DynamicResource ControlPrimaryDefaultBorderBrush}"
                        Foreground="White"
                        FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
