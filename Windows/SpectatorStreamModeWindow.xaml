<Window x:Class="Spark.SpectatorStreamModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Spectator Stream"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceGround}"
        Icon="/img/ignite_logo.ico"
        FontSize="14">
    <Window.Resources>
        <Style x:Key="ModeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ControlMouseOverBackground}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ControlMouseOverBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,22,24,22">
        <TextBlock Text="Spectate which mode?" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
        <TextBlock Text="Spectates the highest level public match at any given time."
                   FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{DynamicResource TextDim}" Margin="0,0,0,18"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ArenaButton" Content="ARENA" Width="130" Height="52" Margin="0,0,10,0"
                    Style="{StaticResource ModeButtonStyle}" Click="ArenaClicked"/>
            <Button x:Name="CombatButton" Content="COMBAT" Width="130" Height="52"
                    Style="{StaticResource ModeButtonStyle}" Click="CombatClicked"/>
        </StackPanel>
    </StackPanel>
</Window>
