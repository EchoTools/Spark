<UserControl x:Class="Spark.ServerInfo"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:p="clr-namespace:Spark.Properties"
		xmlns:l="clr-namespace:Spark"
		xmlns:w="clr-namespace:Spark.Windows"
		mc:Ignorable="d"
		d:DesignHeight="900"
		d:DesignWidth="900"
		Background="{DynamicResource SurfaceGround}"
		FontSize="16"
		DataContext="{Binding RelativeSource={RelativeSource Self}}"
		Loaded="OnControlLoaded"
		>
	<UserControl.Resources>
		<Style x:Key="CardHeading" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11.5"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
		</Style>

		<Style x:Key="ServerInfoTextBox" TargetType="TextBox">
			<Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
			<Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="FontFamily" Value="Consolas"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="10"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border Background="{TemplateBinding Background}" CornerRadius="7" SnapsToDevicePixels="True">
							<ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="RefreshTracerouteButton" TargetType="Button">
			<Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Padding" Value="10,4,10,4"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="{DynamicResource ControlMouseOverBackground}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBorder}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<Grid Background="{DynamicResource SurfaceGround}" Margin="16,14,16,16">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="3*"/>
			<ColumnDefinition Width="4*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="5*"/>
			<RowDefinition Height="4*"/>
		</Grid.RowDefinitions>

		<!-- Server Location -->
		<Grid Grid.Column="0" Grid.Row="0" Margin="0,0,10,10">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<TextBlock Grid.Row="0" Text="SERVER LOCATION" Style="{StaticResource CardHeading}" Margin="2,0,0,8"/>
			<Border Grid.Row="1" Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource SurfaceBorder}"
					BorderThickness="1" CornerRadius="8">
				<TextBox x:Name="FullServerLocationTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
						 Style="{StaticResource ServerInfoTextBox}"/>
			</Border>
		</Grid>

		<!-- Traceroute -->
		<Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="10,0,0,0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<DockPanel Grid.Row="0" Margin="2,0,0,8">
				<Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshTraceroute" Style="{StaticResource RefreshTracerouteButton}"/>
				<TextBlock Text="TRACEROUTE" Style="{StaticResource CardHeading}" VerticalAlignment="Center"/>
			</DockPanel>
			<Border Grid.Row="1" Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource SurfaceBorder}"
					BorderThickness="1" CornerRadius="8">
				<TextBox x:Name="TracerouteTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
						 Style="{StaticResource ServerInfoTextBox}"/>
			</Border>
		</Grid>

		<!-- Player Pings -->
		<Grid Grid.Column="0" Grid.Row="1" Margin="0,10,10,0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<DockPanel Grid.Row="0" Margin="2,0,0,8">
				<Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceRaised}" CornerRadius="9" Padding="8,2,8,2">
					<TextBlock x:Name="serverScoreValueText" Text="--" FontSize="10.5" FontFamily="Consolas"
							   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
				</Border>
				<TextBlock Text="PLAYER PINGS" Style="{StaticResource CardHeading}" VerticalAlignment="Center"/>
			</DockPanel>
			<Border Grid.Row="1" Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource SurfaceBorder}"
					BorderThickness="1" CornerRadius="8" ClipToBounds="True">
				<StackPanel>
					<Border Background="{DynamicResource TeamBlueTint}" Padding="10,6,10,6"
							BorderBrush="{DynamicResource TeamBlueEdge}" BorderThickness="0,0,0,1">
						<StackPanel Orientation="Horizontal">
							<Rectangle Width="3" Height="12" RadiusX="2" RadiusY="2" Fill="{DynamicResource TeamBlue}"
									   VerticalAlignment="Center"/>
							<TextBlock Text="BLUE" FontSize="9.5" FontWeight="SemiBold" Margin="8,0,0,0"
									   VerticalAlignment="Center" Foreground="{DynamicResource TeamBlue}"/>
						</StackPanel>
					</Border>
					<StackPanel Orientation="Horizontal" Margin="10,8,10,10">
						<TextBlock x:Name="bluePlayerPingsPingsServerInfoTab" Text="" VerticalAlignment="Top"
								   FontFamily="Consolas" FontSize="11.5" Width="40" TextAlignment="Right"
								   Foreground="{DynamicResource TextDim}"/>
						<TextBlock x:Name="bluePlayerPingsNamesServerInfoTab" Text="" VerticalAlignment="Top"
								   FontSize="11.5" Margin="10,0,0,0" Foreground="{DynamicResource TextPrimary}"/>
					</StackPanel>

					<Border Background="{DynamicResource TeamOrangeTint}" Padding="10,6,10,6"
							BorderBrush="{DynamicResource TeamOrangeEdge}" BorderThickness="0,0,0,1">
						<StackPanel Orientation="Horizontal">
							<Rectangle Width="3" Height="12" RadiusX="2" RadiusY="2" Fill="{DynamicResource TeamOrange}"
									   VerticalAlignment="Center"/>
							<TextBlock Text="ORANGE" FontSize="9.5" FontWeight="SemiBold" Margin="8,0,0,0"
									   VerticalAlignment="Center" Foreground="{DynamicResource TeamOrange}"/>
						</StackPanel>
					</Border>
					<StackPanel Orientation="Horizontal" Margin="10,8,10,10">
						<TextBlock x:Name="orangePlayerPingsPingsServerInfoTab" Text="" VerticalAlignment="Top"
								   FontFamily="Consolas" FontSize="11.5" Width="40" TextAlignment="Right"
								   Foreground="{DynamicResource TextDim}"/>
						<TextBlock x:Name="orangePlayerPingsNamesServerInfoTab" Text="" VerticalAlignment="Top"
								   FontSize="11.5" Margin="10,0,0,0" Foreground="{DynamicResource TextPrimary}"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Grid>
	</Grid>
</UserControl>
