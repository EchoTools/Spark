<UserControl x:Class="Spark.FriendsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:l="clr-namespace:Spark"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <!-- Every colour below comes from the active theme, so a theme change repaints the tab
             live. The row colours are driven off the view model's Accent/Presence enums rather
             than brushes it hands over, which is what lets DynamicResource do that work. -->

        <Style x:Key="FriendsHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="FriendsHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ControlMouseOverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentActionButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Background" Value="{DynamicResource ControlAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlAccentForeground}"/>
        </Style>

        <!-- Join button: takes the friend's team colour where they have one. -->
        <Style x:Key="JoinButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Background" Value="{DynamicResource ControlAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlAccentForeground}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Accent}" Value="Blue">
                    <Setter Property="Background" Value="{DynamicResource TeamBlue}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TeamBlueForeground}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Accent}" Value="Orange">
                    <Setter Property="Background" Value="{DynamicResource TeamOrange}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TeamOrangeForeground}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RemoveFriendButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceRaised}"/>
                                <Setter Property="Foreground" Value="{DynamicResource StatusBad}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Online dot: grey when offline, amber in a menu or lobby, green in a match. -->
        <Style x:Key="PresenceDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource SurfaceTrack}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Presence}" Value="Menu">
                    <Setter Property="Fill" Value="{DynamicResource TextFaint}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Presence}" Value="Lobby">
                    <Setter Property="Fill" Value="{DynamicResource StatusWarn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Presence}" Value="Match">
                    <Setter Property="Fill" Value="{DynamicResource StatusGood}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Accent}" Value="Blue">
                    <Setter Property="Background" Value="{DynamicResource TeamBlue}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Accent}" Value="Orange">
                    <Setter Property="Background" Value="{DynamicResource TeamOrange}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Accent}" Value="Blue">
                    <Setter Property="Foreground" Value="{DynamicResource TeamBlueForeground}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Accent}" Value="Orange">
                    <Setter Property="Foreground" Value="{DynamicResource TeamOrangeForeground}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FriendsTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource SurfaceGround}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfaceGround}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!-- LEFT: Friends List                          -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid Grid.Column="0" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Friends" FontSize="24" Style="{StaticResource FriendsHeading}" VerticalAlignment="Center"/>
                <Border x:Name="OnlineCountBadge" Background="{DynamicResource StatusGood}" CornerRadius="10" Padding="8,2"
                        Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="OnlineCountText" Text="0 Online" FontSize="11" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                </Border>
                <Border Background="{DynamicResource StatusWarn}" CornerRadius="10" Padding="8,2"
                        Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="WIP" FontSize="11" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <!-- Not logged in panel -->
            <Border x:Name="NotLoggedInPanel" Grid.Row="1" Background="{DynamicResource SurfaceCard}"
                    BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="8"
                    Padding="40" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🔒" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Log in with Discord to use Friends" FontSize="18" Style="{StaticResource FriendsHeading}"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Style="{StaticResource FriendsHint}" TextAlignment="Center" MaxWidth="320">
                        Use the Discord login button at the top left of Spark.
                        Once logged in, your friend code will appear on the right
                        and you can start adding friends.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Friends list (visible when logged in) -->
            <ScrollViewer x:Name="FriendsSection" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                <StackPanel>
                    <ItemsControl x:Name="FriendsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource SurfaceBorder}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="16,12"
                                        Opacity="{Binding Opacity}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Width="12" Height="12" Style="{StaticResource PresenceDot}"
                                                 VerticalAlignment="Top" Margin="0,4,16,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <Border Style="{StaticResource StatusBadge}" Visibility="{Binding ShowStatusBadge}">
                                                    <TextBlock Text="{Binding StatusBadgeText}" Style="{StaticResource StatusBadgeText}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextDim}" Margin="0,4,0,0" TextWrapping="Wrap">
                                                <Run Text="{Binding ModeText}" FontWeight="SemiBold"/>
                                                <Run Text="{Binding SeparatorText}"/>
                                                <Run Text="{Binding SessionTypeText}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding SessionIdText}" FontSize="10" Foreground="{DynamicResource TextFaint}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="×" Width="30" Height="30" Margin="0,0,10,0"
                                                Style="{StaticResource RemoveFriendButton}"
                                                VerticalAlignment="Center" Click="RemoveFriendClicked" Tag="{Binding FriendCode}"
                                                ToolTip="Remove friend"/>

                                        <Button Grid.Column="3" Content="Join" Width="70" Height="32"
                                                Style="{StaticResource JoinButton}" VerticalAlignment="Center"
                                                IsEnabled="{Binding IsJoinable}" Visibility="{Binding ShowJoinButton}"
                                                ToolTip="{Binding JoinButtonTooltip}"
                                                Click="JoinFriendClicked"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <Border x:Name="EmptyFriendsHint" Background="Transparent" Padding="40" Visibility="Visible">
                        <TextBlock Text="No friends added yet. Enter a friend code on the right to get started!"
                                   Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap" FontSize="13" TextAlignment="Center"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════════════════════════════════════ -->
        <!-- RIGHT: Side Panel                           -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Column="1" Background="{DynamicResource SurfaceChrome}"
                BorderBrush="{DynamicResource SurfaceBorderSoft}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">

                    <!-- Add Friend -->
                    <TextBlock Text="Add Friend" FontSize="18" Style="{StaticResource FriendsHeading}" Margin="0,0,0,6"/>
                    <TextBlock Text="Enter a friend code to add them to your list."
                               Style="{StaticResource FriendsHint}" Margin="0,0,0,12"/>

                    <TextBox x:Name="AddFriendCodeBox" Height="34" Style="{StaticResource FriendsTextBox}"
                             MaxLength="9" FontSize="14" KeyDown="AddFriendKeyDown"/>

                    <Button Content="Add Friend" Height="34" Margin="0,10,0,0"
                            Style="{StaticResource AccentActionButton}" Click="AddFriendClicked"/>

                    <StackPanel x:Name="MyFriendCodeSection" Visibility="Collapsed">
                        <Separator Margin="0,24,0,24" Background="{DynamicResource SurfaceBorderSoft}"/>

                        <TextBlock Text="Your Friend Code" FontSize="18" Style="{StaticResource FriendsHeading}" Margin="0,0,0,6"/>
                        <TextBlock Text="Share this code with others so they can add you."
                                   Style="{StaticResource FriendsHint}" Margin="0,0,0,16"/>

                        <Border Background="{DynamicResource SurfaceGround}" BorderBrush="{DynamicResource SurfaceBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <TextBlock x:Name="MyFriendCodeText" Text="········"
                                       FontSize="28" FontWeight="Bold" FontFamily="Consolas"
                                       Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                        </Border>

                        <Button Content="Copy Code" Height="32" Margin="0,10,0,0"
                                Style="{StaticResource RoundedButton}" BorderBrush="{DynamicResource SurfaceBorder}"
                                Click="CopyCodeClicked"/>

                        <Separator Margin="0,24,0,24" Background="{DynamicResource SurfaceBorderSoft}"/>
                        <TextBlock Text="Visibility" FontSize="15" Style="{StaticResource FriendsHeading}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="VisibilityDescription" Text="You are visible to friends."
                                   Style="{StaticResource FriendsHint}" FontSize="11" Margin="0,0,0,10"/>
                        <Button x:Name="VisibilityToggleButton" Height="34"
                                Style="{StaticResource RoundedButton}" BorderBrush="{DynamicResource SurfaceBorder}"
                                FontWeight="Normal" Click="VisibilityToggleClicked">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="VisibilityDot" Width="10" Height="10" Fill="{DynamicResource StatusGood}" Margin="0,0,10,0"/>
                                <TextBlock x:Name="VisibilityButtonText" Text="Visible — Click to Hide" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- How it works -->
                    <Separator Margin="0,24,0,24" Background="{DynamicResource SurfaceBorderSoft}"/>
                    <TextBlock Text="How It Works" FontSize="16" Style="{StaticResource FriendsHeading}" Margin="0,0,0,10"/>
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="1. Share your friend code with a friend" Style="{StaticResource FriendsHint}" FontSize="11" Foreground="{DynamicResource TextFaint}" Margin="0,0,0,6"/>
                        <TextBlock Text="2. They enter your code and click Add Friend" Style="{StaticResource FriendsHint}" FontSize="11" Foreground="{DynamicResource TextFaint}" Margin="0,0,0,6"/>
                        <TextBlock Text="3. Spark shows where each friend is — match, private match or lobby" Style="{StaticResource FriendsHint}" FontSize="11" Foreground="{DynamicResource TextFaint}" Margin="0,0,0,6"/>
                        <TextBlock Text="4. Click Join to hop into their game instantly" Style="{StaticResource FriendsHint}" FontSize="11" Foreground="{DynamicResource TextFaint}" Margin="0,0,0,6"/>
                    </StackPanel>

                    <!-- Status footer -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,8">
                        <Ellipse x:Name="ApiStatusDot" Width="8" Height="8" Fill="{DynamicResource SurfaceTrack}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ApiStatusText" Text="Not connected" FontSize="11" Foreground="{DynamicResource TextFaint}"/>
                    </StackPanel>
                    <Button Content="Refresh" Click="RefreshClicked" Height="26" FontSize="11"
                            Style="{StaticResource RoundedButton}" Background="Transparent" FontWeight="Normal"
                            BorderBrush="{DynamicResource SurfaceBorderSoft}" BorderThickness="1"
                            Foreground="{DynamicResource TextDim}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
